{
  "name": "dsh-plugin-favorability",
  "version": "0.1.0",
  "description": "A private first-person favorability score for DeepSeek Harness: the model judges whether an exchange fits its feelings, keeps a score, and lets that score color its tone.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "favorability",
    "persona",
    "roleplay"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
